{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="stack">
    <section class="hero">
        {% if viewer.isOwner %}
            <h1>Ta liste, vue par tes proches</h1>
            <p class="lead">Mode propriétaire : les réservations sont masquées, la surprise est préservée. 🤫</p>
        {% else %}
            <h1>Tu cherches un cadeau pour {{ owner_name }} ?</h1>
            <p class="lead">{{ owner_name }} collectionne <strong>{{ collection_focus }}</strong>. Vérifie qu'il n'a pas déjà le set, puis réserve-le pour éviter les doublons.</p>
        {% endif %}
        <div class="mt">{% include 'gift/_search.html.twig' %}</div>
    </section>

    {% if highlights is not empty %}
        <section>
            <div class="row-between mb">
                <h2>{{ viewer.isGiver ? 'Idées encore disponibles' : 'Ses envies du moment' }}
                    <small>({{ availableCount }})</small></h2>
                <a href="{{ path('gift_list') }}" class="btn btn-ghost btn-sm">Voir toute la liste →</a>
            </div>
            <div class="set-grid">
                {% for set in highlights %}
                    {{ m.set_card(set, viewer.canSeeReservations, path('gift_detail', {numero: set.numeroSet})) }}
                {% endfor %}
            </div>
        </section>
    {% else %}
        <div class="card empty">
            <span class="emoji">🎉</span>
            {% if viewer.isGiver %}
                Tous les sets de la liste sont déjà réservés ou possédés.<br>
                Tu peux quand même vérifier un numéro au-dessus : s'il n'est pas dans sa collection, tu pourras le réserver.
            {% else %}
                Aucun souhait pour le moment.
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
