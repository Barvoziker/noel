{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}La liste{% endblock %}

{% block body %}
{% set reveal = viewer.canSeeReservations %}
{% set tabs = reveal
    ? {available: '🎁 À offrir', wanted: '⭐ Tous ses souhaits', owned: '🏠 Déjà possédés', all: 'Tout'}
    : {wanted: '⭐ Souhaits', owned: '🏠 Possédés', all: 'Tout'} %}

<div class="stack">
    <div class="row-between">
        <h1>La liste de {{ owner_name }}</h1>
        <span class="muted">{{ sets|length }} set{{ sets|length > 1 ? 's' }}</span>
    </div>

    <nav class="chips" aria-label="Filtres">
        {% for key, label in tabs %}
            <a class="chip {{ filter == key ? 'active' }}" href="{{ path('gift_list', {filter: key, q: q ?: null, theme: theme, sort: sort}) }}">{{ label }}</a>
        {% endfor %}
    </nav>

    <form method="get" class="toolbar card card-tight">
        <input type="hidden" name="filter" value="{{ filter }}">
        <input type="search" name="q" value="{{ q }}" class="input" placeholder="Filtrer par nom, numéro, thème…" aria-label="Filtrer">
        <select name="theme" class="select" aria-label="Thème">
            <option value="">Tous les thèmes</option>
            {% for t in themes %}<option value="{{ t }}" {{ t == theme ? 'selected' }}>{{ t }}</option>{% endfor %}
        </select>
        <select name="sort" class="select" aria-label="Trier">
            {% for key, label in {priorite: 'Ses préférés d\'abord', prix: 'Prix croissant', nom: 'Nom', numero: 'Numéro', annee: 'Plus récents'} %}
                <option value="{{ key }}" {{ key == sort ? 'selected' }}>{{ label }}</option>
            {% endfor %}
        </select>
        <button class="btn">Appliquer</button>
    </form>

    {% if filter == 'available' %}
        <p class="alert alert-info">Ces sets sont souhaités et personne ne les a encore réservés. Clique sur un set pour le réserver.</p>
    {% endif %}

    {% if sets is empty %}
        <div class="card empty">
            <span class="emoji">🔍</span>
            Aucun set ne correspond.
            {% if q %}<div class="mt"><a class="btn" href="{{ path('gift_search', {q: q}) }}">Vérifier « {{ q }} » quand même</a></div>{% endif %}
        </div>
    {% else %}
        <div class="set-grid">
            {% for set in sets %}
                {{ m.set_card(set, reveal, path('gift_detail', {numero: set.numeroSet})) }}
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
