{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1>{{ title }}</h1>
        <a href="{{ path('admin_sets') }}" class="btn">← Retour à la liste</a>
    </div>
</div>

<div class="card">
    <form method="post">
        <div class="form-group">
            <label for="numero_set">Numéro du set LEGO * :</label>
            <input type="text" id="numero_set" name="numero_set" class="form-control" 
                   value="{{ set.numeroSet ?? '' }}" placeholder="Ex: 75302" required>
        </div>

        <div class="form-group">
            <label for="nom">Nom du set * :</label>
            <input type="text" id="nom" name="nom" class="form-control" 
                   value="{{ set.nom ?? '' }}" placeholder="Ex: Imperial Star Destroyer" required>
        </div>

        <div class="form-group">
            <label for="theme">Thème :</label>
            <input type="text" id="theme" name="theme" class="form-control" 
                   value="{{ set.theme ?? '' }}" placeholder="Ex: Star Wars">
        </div>

        <div class="form-group">
            <label for="annee">Année :</label>
            <input type="number" id="annee" name="annee" class="form-control" 
                   value="{{ set.annee ?? '' }}" placeholder="Ex: 2023" min="1950" max="2030">
        </div>

        <div class="form-group">
            <label for="image_url">URL de l'image :</label>
            <input type="url" id="image_url" name="image_url" class="form-control" 
                   value="{{ set.imageUrl ?? '' }}" placeholder="https://...">
        </div>

        <div class="form-group">
            <label>
                <input type="checkbox" id="owned" name="owned" value="1" 
                       {% if set.owned %}checked{% endif %}>
                🏠 Je possède déjà ce set
            </label>
            <small style="display: block; color: #666; margin-top: 5px;">
                Cocher si tu as déjà ce set dans ta collection
            </small>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success">💾 Enregistrer</button>
            <a href="{{ path('admin_sets') }}" class="btn" style="margin-left: 10px;">Annuler</a>
        </div>
    </form>
</div>

{% if set.imageUrl %}
<div class="card text-center">
    <h3>Aperçu de l'image :</h3>
    <img src="{{ set.imageUrl }}" alt="{{ set.nom }}" style="max-width: 300px; height: auto; border-radius: 8px;">
</div>
{% endif %}
{% endblock %}
