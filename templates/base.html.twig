<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex">
        <title>{% block title %}Collection LEGO{% endblock %} · Collection LEGO</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧱</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block head %}{% endblock %}
    </head>
    <body>
        {% set route = app.request.attributes.get('_route') ?? '' %}
        {% set is_admin = route starts with 'admin' %}
        <header class="site-header">
            <div class="container">
                <a class="brand" href="{{ is_admin ? path('admin_dashboard') : path('gift_home') }}">
                    <span class="brand-brick" aria-hidden="true"></span>
                    Collection LEGO{% if not is_admin %} de {{ owner_name }}{% endif %}
                </a>
                <nav class="nav" aria-label="Navigation principale">
                    {% if is_admin %}
                        <a href="{{ path('admin_dashboard') }}" class="{{ route == 'admin_dashboard' ? 'active' }}">Tableau de bord</a>
                        <a href="{{ path('admin_sets') }}" class="{{ route in ['admin_sets', 'admin_sets_edit'] ? 'active' }}">Mes sets</a>
                        <a href="{{ path('admin_sets_new') }}" class="{{ route == 'admin_sets_new' ? 'active' }}">+ Ajouter</a>
                        <a href="{{ path('admin_catalog') }}" class="{{ route == 'admin_catalog' ? 'active' }}">🏎 Catalogue</a>
                        <a href="{{ path('admin_import') }}" class="{{ route == 'admin_import' ? 'active' }}">Import</a>
                        <a href="{{ path('gift_home') }}">Page des proches ↗</a>
                    {% elseif viewer.hasChosen %}
                        <a href="{{ path('gift_home') }}" class="{{ route == 'gift_home' ? 'active' }}">Accueil</a>
                        <a href="{{ path('gift_list') }}" class="{{ route == 'gift_list' ? 'active' }}">La liste</a>
                        {% if viewer.isGiver %}
                            <a href="{{ path('gift_my_reservations') }}" class="{{ route == 'gift_my_reservations' ? 'active' }}">Mes réservations</a>
                        {% else %}
                            <a href="{{ path('admin_dashboard') }}">Mon espace</a>
                        {% endif %}
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="container">
            {% set flashes = app.flashes %}
            {% if flashes is not empty %}
                <div class="flashes" role="status">
                    {% for type, messages in flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'info' ? 'info' : 'error') }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container row-between">
                <span>🧱 Collection LEGO — zéro cadeau en double.</span>
                {% if not is_admin and viewer.hasChosen %}
                    <a href="{{ path('gift_role', {role: 'personne'}) }}">{{ viewer.isOwner ? 'Je ne suis pas ' ~ owner_name : 'Changer de profil' }}</a>
                {% endif %}
            </div>
        </footer>

        <script>
            // Image manquante → petite brique à la place
            document.addEventListener('error', function (e) {
                var img = e.target;
                if (img.tagName === 'IMG' && img.dataset.fallback !== undefined) {
                    var brick = document.createElement('div');
                    brick.className = 'img-fallback';
                    brick.setAttribute('role', 'img');
                    brick.setAttribute('aria-label', img.alt);
                    img.replaceWith(brick);
                }
            }, true);
            // Confirmation avant les actions sensibles
            document.addEventListener('submit', function (e) {
                var msg = e.target.dataset.confirm;
                if (msg && !window.confirm(msg)) { e.preventDefault(); }
            });
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
